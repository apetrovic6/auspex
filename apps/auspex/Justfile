mod lib '../../just/lib.just'
mod crux '../../just/crux.just'

app := "auspex"
core_pkg := "auspex-core"
app_dir := justfile_directory()
core_dir := app_dir / "core"

# Rust crates belonging to this app, as paths relative to this file. These are Cargo
# workspace members (apps/*/core and apps/*/shells/*), so creating a directory here is the
# only registration step — but this list is what the aggregate recipes below walk, so a new
# shell goes in both places. `just add-shell auspex <tui|web|desktop>` does both at
# once, and allocates the web shell's trunk port while it is at it: the entry is the half a
# person forgets, and a shell no recipe walks is a crate no gate checks.
rust_modules := "core shells/tui"

# Native platform projects are DISCOVERED, not listed: any platforms/<name>/Justfile is
# one. Adding a platform — `just add platform-android auspex` — therefore needs no
# edit here, the same property the Cargo globs give the workspace.
#
# Xcode exists only on macOS, so the apple project is skipped elsewhere rather than failing.
[script('bash')]
_platforms:
    shopt -s nullglob
    for f in platforms/*/Justfile; do
        p=$(dirname "$f")
        if [ "$(basename "$p")" = apple ] && [ '{{ os() }}' != macos ]; then continue; fi
        echo "$p"
    done

default: dev

# --------------------------------------------------------------------------
# Rust
# --------------------------------------------------------------------------

[script('bash')]
doctor:
    set -euo pipefail
    for m in {{ rust_modules }} $(just _platforms); do
        echo '{{ style("command") }}'"{{ app }}/$m:"'{{ NORMAL }}'
        just "$m/doctor"
    done

[script('bash')]
fix:
    set -euo pipefail
    for m in {{ rust_modules }}; do just "$m/fix"; done

[script('bash')]
check:
    set -euo pipefail
    for m in {{ rust_modules }}; do
        echo '{{ style("command") }}'"{{ app }}/$m:"'{{ NORMAL }}'
        just "$m/check"
    done

[script('bash')]
build:
    set -euo pipefail
    for m in {{ rust_modules }}; do
        echo '{{ style("command") }}'"{{ app }}/$m:"'{{ NORMAL }}'
        just "$m/build"
    done

[script('bash')]
test:
    set -euo pipefail
    for m in {{ rust_modules }}; do
        echo '{{ style("command") }}'"{{ app }}/$m:"'{{ NORMAL }}'
        just "$m/test"
    done

dev: fix check build test
ci: check build test

# --------------------------------------------------------------------------
# Code generation
# --------------------------------------------------------------------------
# Two generators feed a native platform project, driven from here with absolute paths so
# they share one working directory:
#
#   typegen -> serde/bincode types (Event, ViewModel, Effect) from the Crux core
#   pack    -> the FFI surface and prebuilt native libraries from core/boltffi.toml
#
# Both refuse, as their first line, when the app has no project for that platform — a product
# scaffolded with one platform does not carry a recipe that pretends at the other. The check
# is the first line of the GENERATOR rather than a guard in the `android`/`apple` recipes
# below, for two reasons measured in RT-13:
#
#   - `android: generate-android` runs the dependency before its body, so a guard in that
#     body fires only after everything below has already run. And everything below WRITES:
#     typegen creates `platforms/android/generated` out of nothing. A late guard therefore
#     leaves the junk it exists to prevent, and nothing ever lists it again — `_platforms`
#     discovers `platforms/*/Justfile`, and there is no Justfile inside.
#   - once `platforms/android` exists but holds no Justfile, `just platforms/android/build`
#     stops saying so. `just` walks up from that directory, finds THIS file, and runs the
#     app's own `build`. Measured, RT-13, on a scaffolded Apple-only app: its `android` recipe
#     compiled every Rust shell, trunk included, printed no complaint and exited 0.
#
# So the guard is what the generator does first, and `android`/`apple` stay typeable and
# explain themselves rather than vanishing with the project. `native` and `generate` are the
# other half of the split: they mean "every platform this host has", so they DISCOVER, via
# `_platforms`, and in a one-platform product they run that one and nothing else.
#
# When adding prose to a recipe's comment block below, note that `just --list` shows only the
# LAST line of it (measured, just 1.58.0). The line nearest the recipe is the one a person
# browsing recipes sees, so it has to read alone; the reasoning goes in the body.

# Kotlin bindings + jniLibs + localization resources into platforms/android/generated
generate-android:
    @test -f platforms/android/Justfile || { echo '  no Android project: platforms/android/Justfile is absent. Add one with' >&2; echo '    just add platform-android {{ app }}' >&2; exit 1; }
    @just crux::typegen {{ core_pkg }} kotlin '{{ app_dir }}/platforms/android/generated'
    @just crux::pack '{{ core_dir }}' android
    # The third feed is the same TOML tree the Rust shells read; it goes in here and
    # not in a recipe of its own because a platform build that skipped it would render
    # the fallback language forever with nothing failing.
    @cargo xtask i18n-resources {{ app }} android

# Swift package + xcframework + String Catalog into platforms/apple/generated (macOS hosts only)
generate-apple:
    # Same guard as generate-android, for the same reasons.
    @test -f platforms/apple/Justfile || { echo '  no Apple project: platforms/apple/Justfile is absent. Add one with' >&2; echo '    just add platform-apple {{ app }}' >&2; exit 1; }
    rm -rf '{{ app_dir }}/platforms/apple/generated/Shared'
    @just crux::typegen {{ core_pkg }} swift '{{ app_dir }}/platforms/apple/generated'
    @just crux::pack '{{ core_dir }}' apple
    # Same third feed as generate-android, for the same reason.
    @cargo xtask i18n-resources {{ app }} apple

# regenerate every platform available on this host
[script('bash')]
generate:
    set -euo pipefail
    # Discovered, exactly as `native` runs them: an unconditional `just generate-android` here
    # was the same bug, and the guard above would otherwise turn a product that has Apple and
    # not Android into a failure on the Android it was never given (RT-13).
    for p in $(just _platforms); do
        n=$(basename "$p")
        just "generate-$n"
    done

# --------------------------------------------------------------------------
# Native platforms
# --------------------------------------------------------------------------
# Only useful once `just add platform-auspex <android|apple>` has created one, and
# that is now enforced rather than merely stated: `generate-android`/`generate-apple` refuse
# without their project (RT-13). They are explicit rather than part of `dev`/`ci` because they
# need an Android SDK or Xcode, which an ordinary Rust checkout has neither of.

# generate bindings, then build the Android app
android: generate-android
    just platforms/android/build

# generate bindings, then build the Apple app (macOS hosts only)
apple: generate-apple
    just platforms/apple/build

# every platform available on this host
[script('bash')]
native:
    set -euo pipefail
    for p in $(just _platforms); do
        just "$(basename "$p")"
    done

# --------------------------------------------------------------------------

[script('bash')]
clean:
    set -euo pipefail
    for m in {{ rust_modules }} $(just _platforms); do just "$m/clean"; done
    just crux::clean-generated \
        '{{ app_dir }}/platforms/android/generated' \
        '{{ app_dir }}/platforms/apple/generated'

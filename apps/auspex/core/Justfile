mod lib '../../../just/lib.just'
mod rust '../../../just/rust.just'

pkg := "auspex-core"

default: dev

# checks required tools are installed. `check-rust`, not the template's `check-crux-core`:
# that one adds boltffi, which only the FFI shells need, and auspex has none.
doctor:
    @echo '{{ style("command") }}doctor:{{ NORMAL }}'
    @just lib::check-rust

# auto-fix formatting issues
fix:
    @just rust::fmt

# validate formatting and lint. Natively only: no shell builds this crate for wasm32.
check:
    @just rust::fmt-check
    @just rust::clippy {{ pkg }} --all-targets

build:
    @just rust::build {{ pkg }}

test:
    @just rust::test {{ pkg }}

clean:
    cargo clean -p {{ pkg }}

dev: fix check build test
ci: check build test

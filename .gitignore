# Rust
/target/
**/target/

# Persistent inode used for nonblocking recipe mutation locks.
/.template/recipe.lock

# Nix / devenv
.devenv*
devenv.local.nix
devenv.local.yaml
.direnv/

# pre-commit (managed by devenv git-hooks)
.pre-commit-config.yaml

# Android / Gradle — machine-specific or generated
local.properties
.gradle/
.kotlin/
.android/
build/

# Xcode — generated by xcodegen
*.xcodeproj/
*.xcworkspace/
DerivedData/

# IDE
.idea/
.vscode/

# Generated bindings and packed artefacts (produced by `just <app>/typegen`)
generated/

# Web build output
dist/
node_modules/

# Agent worktrees. The harness creates them under here by default, and untracked is not
# ignored: without this entry a `git add -A` in the main checkout stages whole second copies
# of the repository, target/ included. `.claude/` itself cannot be ignored —
# `.claude/skills/*/SKILL.md` is tracked and belongs to the repository, and `rename` reaches
# it through PATHS_ONLY_TREES — so the entry is this directory and only this directory.
.claude/worktrees/

# icu4x-datagen's download cache (~80 MB of CLDR JSON). The tool has no flag for its location
# — it writes relative to the working directory, and `just i18n::generate-data` runs it at the
# repository root, where a second run reuses it instead of downloading again. The ~124 KB that
# matters is committed as `crates/i18n-data/src/data`.
icu4x-source-cache/
